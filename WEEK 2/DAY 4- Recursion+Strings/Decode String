#The encoding rule is: k[encoded_string], where the encoded_string inside the square brackets is being repeated exactly k times. Note that k 
is guaranteed to be a positive integer.

class Solution:
    def decodeString(self, s):
        stack=[]
        current_num=0
        decoded_string=""
        for i in s:
            if i in "0123456789":
                current_num=current_num*10+int(i)
            elif i >="a" and i<="z":
                decoded_string+=i
            elif i=="[":
                stack.append([current_num,decoded_string])
                current_num=0
                decoded_string=""

            elif i=="]":
                c=stack.pop()
                decoded_string=c[1]+decoded_string*c[0]
        
        return decoded_string
