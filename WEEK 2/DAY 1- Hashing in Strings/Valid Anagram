#Given two strings s and t,return true if t is an anagram of s, and false otherwise.

class Solution:
    def isAnagram(self, s,t):
        if (len(s))==(len(t)):
            hash_array1=[0*26 for i in range(26)]
            hash_array2=[0*26 for i in range(26)]
            for char in s:
                hash_array1[ord(char)-ord('a')]+=1
            for char in t:
                hash_array2[ord(char)-ord('a')]+=1

            if (hash_array1==hash_array2):
                return True
            else:
                return False
        else:
            return False
        
