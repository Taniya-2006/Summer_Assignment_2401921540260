#Move all 0's to the end while maintaining the relative order

class Solution:
    def moveZeroes(self, nums):
        j=-1
        for i in range(len(nums)):
            if nums[i]==0:
                j=i
                break
        for i in range(j+1,len(nums)):
            if (nums[j]==0 and nums[i]!=0):
                nums[j],nums[i]=nums[i],nums[j]
                j+=1
