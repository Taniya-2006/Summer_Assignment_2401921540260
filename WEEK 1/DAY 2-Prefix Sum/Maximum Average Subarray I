#Finding a subarray whose length equal to k having maximum average value

class Solution:
    def findMaxAverage(self, nums, k):
        max_sum=float("-inf")
        current_sum=sum(nums[:k])
        max_sum=current_sum
        for i in range(k,len(nums)):
            current_sum+=nums[i]-nums[i-k]
            max_sum=max(max_sum,current_sum)
        return max_sum/k        
