#Given a string s containing just the characters '(', ')', '{', '}', '[' and ']', determine if the input string is valid.

class Solution:
    def isValid(self, s: str) -> bool:
        stack=[]
        for i in s:
            if i in "([{":
                stack.append(i)
            elif i==")":
                if stack==[]:
                    return False
                elif stack[-1]=="(":
                    stack.pop()
                else:
                    return False
            elif i=="]":
                if stack==[]:
                    return False
                elif stack[-1]=="[":
                    stack.pop()
                else:
                    return False
            elif i=="}":
                if stack==[]:
                    return False
                elif stack[-1]=="{":
                    stack.pop()
                else:
                    return False
        if stack==[]:
            return True
        else:
            return False
        
