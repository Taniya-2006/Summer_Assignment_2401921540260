#You have a RecentCounter class which counts the number of recent requests within a certain time frame.

class RecentCounter:

    def __init__(self):
        self.stack=[]
    def ping(self, t: int) -> int:
        self.stack.append(t)
        while self.stack and  self.stack[0]<t-3000:
            self.stack.pop(0)
        return len(self.stack)
